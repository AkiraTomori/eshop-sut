  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const studentId = pm.environment.get('StudentID');",
          "if (!studentId || !String(studentId).trim()) {",
          "  console.warn('StudentID is empty; refusing to send the HW06 request.');",
          "  throw new Error('StudentID environment variable is required');",
          "}",
          "const baseUrl = String(pm.environment.get('baseUrl') || '').replace(/\\/$/, '');",
          "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):3000$/.test(baseUrl)) {",
          "  throw new Error('Pool B execution is restricted to http://localhost:3000 or http://127.0.0.1:3000');",
          "}",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: studentId });",
          "console.log('X-Student-Id injected for', (pm.iterationData.get('testCaseId') || pm.info.requestName));"
        ]
      }
    }
  ],
