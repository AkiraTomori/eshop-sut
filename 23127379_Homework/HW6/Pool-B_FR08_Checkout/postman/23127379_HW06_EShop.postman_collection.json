                  "          const email = 'hw06.' + runId + '.' + safeId + '.u1@example.invalid';",
                  "          pm.environment.set('runtimeU1Email', email);",
                  "          pm.variables.set('runtimeU1RegisterBody', JSON.stringify({ name: 'HW06 ' + testCaseId + ' U1', email: email, password: password }));",
                  "        })();"
                ]
              }
