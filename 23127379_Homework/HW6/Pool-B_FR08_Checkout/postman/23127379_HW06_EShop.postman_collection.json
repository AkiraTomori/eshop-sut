    {
      "name": "Pool B - FR-08 Checkout",
      "description": "The only scored/test-target folder. Contains 42 approved data-driven POST /api/checkout cases; fixture requests in the preceding folder do not count.",
      "item": [
        {
          "name": "{{testCaseId}} - POST /api/checkout",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  const id = pm.iterationData.get('testCaseId');",
                  "  if (pm.iterationData.get('enabled') !== true) {",
                  "    console.warn(id + ' skipped: ' + pm.iterationData.get('disabledReason'));",
                  "    pm.execution.skipRequest();",
                  "    return;",
                  "  }",
                  "  const authMode = pm.iterationData.get('authMode');",
                  "  pm.request.headers.remove('Authorization');",
                  "  function requireRuntime(key) {",
                  "    const value = pm.variables.get(key);",
                  "    if (value === undefined || value === null || !String(value).trim()) throw new Error(key + ' runtime value is required for ' + id);",
                  "    return String(value);",
                  "  }",
                  "  if (authMode === 'emptyBearer') pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' });",
                  "  else if (authMode === 'basic') pm.request.headers.upsert({ key: 'Authorization', value: 'Basic dGVzdDp0ZXN0' });",
                  "  else if (authMode === 'malformed') pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer not-a-jwt' });",
                  "  else if (authMode === 'validU1') pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + requireRuntime('u1_token') });",
                  "  else if (authMode === 'validU2') pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + requireRuntime('u2_token') });",
                  "  else if (authMode === 'invalidSignature') {",
                  "    const token = requireRuntime('u1_token');",
                  "    const last = token.slice(-1);",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token.slice(0, -1) + (last === 'A' ? 'B' : 'A') });",
                  "  }",
                  "  else if (authMode === 'expired') pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + requireRuntime('expiredToken') });",
                  "  else if (authMode === 'algNone') {",
                  "    const token = requireRuntime('u1_token');",
                  "    const parts = token.split('.');",
                  "    if (parts.length !== 3) throw new Error('u1_token is not a three-part JWT');",
                  "    const header = btoa(JSON.stringify({ alg: 'none', typ: 'JWT' })).replace(/=/g, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + header + '.' + parts[1] + '.' });",
                  "  }",
                  "  else if (authMode !== 'missing') throw new Error('Unsupported authMode for ' + id + ': ' + authMode);",
                  "  const targetPath = pm.iterationData.get('targetPath') || '/api/checkout';",
                  "  const template = pm.iterationData.get('bodyTemplate');",
                  "  if (typeof template !== 'string') throw new Error('bodyTemplate is required for ' + id);",
                  "  const required = Array.from(template.matchAll(/{{([^}]+)}}/g)).map(function (match) { return match[1]; });",
                  "  required.forEach(requireRuntime);",
                  "  const expanded = pm.variables.replaceIn(template);",
                  "  if (/{{[^}]+}}/.test(expanded)) throw new Error('Unresolved local variable in request body for ' + id);",
                  "  pm.variables.set('runtimeTargetPath', targetPath);",
                  "  pm.variables.set('runtimeTargetBody', expanded);",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.iterationData.get('testCaseId');",
                  "const oracle = pm.iterationData.get('statusOracle');",
                  "const security = String(pm.iterationData.get('securityOracle') || 'noInternal,noSensitive').split(',');",
                  "pm.test(id + ' - method and selected endpoint', function () {",
                  "  pm.expect(pm.request.method).to.eql('POST');",
                  "  pm.expect(pm.request.url.getPath()).to.eql('/api/checkout');",
                  "});",
                  "pm.test(id + ' - X-Student-Id injected', function () {",
                  "  pm.expect(pm.request.headers.get('X-Student-Id')).to.eql(pm.environment.get('StudentID'));",
                  "});",
                  "if (oracle === 'success') pm.test(id + ' - successful HTTP class', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "else if (oracle === 'reject') pm.test(id + ' - rejected without server error', function () { pm.expect(pm.response.code).to.be.within(400, 499); });",
                  "else if (oracle === 'branch') pm.test(id + ' - allowed accept/reject branch without server error', function () { pm.expect(pm.response.code).to.be.within(200, 499); });",
                  "else console.warn(id + ': exact status oracle is unspecified; actual=' + pm.response.code);",
                  "let jsonBody = null;",
                  "try { jsonBody = pm.response.json(); } catch (error) { jsonBody = null; }",
                  "const text = pm.response.text();",
                  "if (security.includes('noInternal')) pm.test(id + ' - no database/internal disclosure', function () {",
                  "  pm.expect(text).not.to.match(/SQLITE|stack trace|syntax error|SELECT[ ]|INSERT[ ]+INTO|UPDATE[ ]+orders|node_modules/i);",
                  "});",
                  "if (security.includes('noSensitive')) pm.test(id + ' - no sensitive credential fields in JSON', function () {",
                  "  if (jsonBody && typeof jsonBody === 'object') {",
                  "    const keys = JSON.stringify(jsonBody).match(/\"[^\"]+\"(?=s*:)/g) || [];",
                  "    const normalized = keys.map(function (key) { return key.replace(/\"/g, '').toLowerCase(); });",
                  "    ['password', 'password_hash', 'passwordhash', 'jwt', 'token', 'secret'].forEach(function (key) { pm.expect(normalized).not.to.include(key); });",
                  "  }",
                  "});",
                  "const expectedTotal = pm.iterationData.get('expectedServerTotal');",
                  "if (pm.response.code >= 200 && pm.response.code < 300 && expectedTotal !== null && expectedTotal !== undefined && jsonBody && typeof jsonBody === 'object') {",
                  "  const candidates = [jsonBody.total_amount, jsonBody.total, jsonBody.order && jsonBody.order.total_amount, jsonBody.order && jsonBody.order.total];",
                  "  const returnedTotal = candidates.find(function (value) { return value !== undefined && value !== null; });",
                  "  if (returnedTotal !== undefined) pm.test(id + ' - conditionally returned total is server-derived', function () {",
                  "    pm.expect(returnedTotal).to.be.a('number');",
                  "    pm.expect(returnedTotal).to.eql(expectedTotal);",
                  "  });",
                  "}",
                  "if (pm.iterationData.get('manualStateEvidenceRequired') === true) console.warn(id + ': MANUAL_STATE_ORACLE_REQUIRED - ' + pm.iterationData.get('expectedSideEffect'));",
                  "console.log(id + ' checkout actual status=' + pm.response.code + '; exact status/schema unspecified by contract');"
                ]
              }
            }
