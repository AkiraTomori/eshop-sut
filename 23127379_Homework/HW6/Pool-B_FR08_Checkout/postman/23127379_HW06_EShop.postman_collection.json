              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "          const needed = pm.iterationData.get('needsU1') === true;",
                  "          pm.environment.unset('u1_token');",
                  "          pm.environment.unset('runtimeU1Id');",
                  "          pm.environment.unset('runtimeU1Email');",
                  "          if (!needed) { pm.execution.skipRequest(); return; }",
